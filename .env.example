# Copy to .env and fill in. Never commit .env (it is gitignored).

# base64-encoded 32-byte master key (generate with `openssl rand -base64 32`)
LIGHT_SECRET_KEY=

# Postgres connection string (default shown)
# DATABASE_URL=postgres://light@127.0.0.1:5432/light

# TCP bind address (default shown)
# ADDR=127.0.0.1:8080

# Comma-separated CORS origins (default shown)
# CORS_ORIGINS=http://localhost:5173

# Origin shown in device-authorization codes (default shown)
# DEVICE_VERIFICATION_URI=http://localhost:5173

# Tracing filter (default shown)
# RUST_LOG=light_factory_server=info,tower_http=info
